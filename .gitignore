# OS
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace
*.swp
*.swo

# Build output
/dist
# JS/CSS are compiled into the plugin's library dir at build time
/src/php/libraries/*

# Dependencies
node_modules/
/.pnp
.pnp.js
yarn.lock
/vendor
/vendor-prefixed

# Testing
/coverage
/.nyc_output
/test-results/
/playwright-report/
/tests/e2e/.auth/
.phpunit.result.cache
# wp-env local override (written by the canary job)
.wp-env.override.json
# In-container shadow of ./vendor (wp-env mapping); never a real host dir
tests/php/dev-vendor/
# Isolated PHPUnit tooling vendor for the integration suites
tests/php/tools/vendor/

# Environment
.env
.env.*
!.env.example

# Logs / caches
*.log
npm-debug.log*
debug.log
*.tsbuildinfo
.cache
.temp
.tmp
.eslintcache
.stylelintcache
.fallow/

# VitePress build artifacts (docs/ itself is committed — it's the public site)
docs/.vitepress/dist
docs/.vitepress/cache

# Generated by `arts-wp doctor`, machine-specific
.mcp.json

# Agent tooling
.claude/
.cursor/
.taskmaster/
tasks.json
tasks/

# Working docs are never committed — docs/ in a public repo holds public
# documentation only. Plans, specs, brainstorms, scratch stay local.
docs/superpowers/
drafts/
.superpowers/
