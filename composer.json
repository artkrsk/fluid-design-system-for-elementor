{
  "name": "arts/fluid-design-system",
  "version": "2.5.3",
  "description": "Fluid spacing and typography units for Elementor",
  "license": "GPL-3.0-or-later",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "Artem Semkin",
      "email": "me@artemsemkin.com",
      "homepage": "https://artemsemkin.com"
    }
  ],
  "homepage": "https://artemsemkin.com",
  "require": {
    "php": ">=8.0",
    "arts/elementor-extension": "@dev",
    "arts/utilities": "@dev"
  },
  "require-dev": {
    "arts/elementor-stubs": "^4.0",
    "brianhenryie/strauss": "^0.27",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "ergebnis/composer-normalize": "^2.48",
    "php-stubs/woocommerce-stubs": "^10.5",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13.4",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^2.0",
    "arts/wp-plugin-standards": "^1.0"
  },
  "minimum-stability": "stable",
  "autoload": {
    "classmap": [
      "vendor-prefixed/"
    ],
    "psr-4": {
      "Arts\\FluidDesignSystem\\": "src/php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Arts\\FluidDesignSystem\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "ArtsFluidDS\\",
      "classmap_prefix": "ArtsFluidDS_",
      "constant_prefix": "ARTS_FLUID_DS_VENDOR_",
      "classmap_output": true,
      "include_modified_date": true,
      "include_author": true,
      "packages": [
        "arts/utilities",
        "arts/base",
        "arts/elementor-extension"
      ],
      "update_call_sites": [
        "src/php",
        "src/wordpress-plugin"
      ],
      "delete_vendor_packages": false,
      "exclude_from_copy": {
        "file_patterns": [
          "/^tests\\//",
          "/phpcs\\.xml/",
          "/phpstan/",
          "/\\.github/",
          "/\\.gitignore/",
          "/composer\\.lock/"
        ]
      }
    }
  },
  "scripts": {
    "pre-autoload-dump": [
      "@php -r \"is_dir('vendor-prefixed') || mkdir('vendor-prefixed');\""
    ],
    "post-install-cmd": [
      "@php -r \"if (file_exists('vendor/bin/strauss')) { passthru(PHP_BINARY . ' vendor/bin/strauss'); passthru('composer dump-autoload'); }\""
    ],
    "post-update-cmd": [
      "@php -r \"if (file_exists('vendor/bin/strauss')) { passthru(PHP_BINARY . ' vendor/bin/strauss'); passthru('composer dump-autoload'); }\""
    ],
    "prefix-namespaces": [
      "@php vendor/bin/strauss",
      "@composer dump-autoload"
    ],
    "check": [
      "@phpcs",
      "@phpstan"
    ],
    "fix": "@phpcbf",
    "normalize": "composer-normalize",
    "phpcbf": "phpcbf --standard=phpcs.xml",
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "test:php:unit": "phpunit -c tests/php/phpunit-unit.xml.dist"
  },
  "plugin": {
    "Description": "Provides comprehensive fluid spacing and typography system for Elementor for smoother and consistent responsive design",
    "License": "GPLv3",
    "License URI": "https://www.gnu.org/licenses/gpl-3.0",
    "Plugin Name": "Fluid Design System for Elementor",
    "Plugin URI": "https://artemsemkin.com/",
    "Text Domain": "fluid-design-system-for-elementor"
  },
  "wordpress": {
    "Requires PHP": "8.0",
    "Requires at least": "6.0",
    "Tested up to": "7.1"
  }
}
