{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/ts/index.ts",
    "project.config.js",
    "docs/.vitepress/config.mts",
    "docs/.vitepress/theme/index.ts",
    "tests/**/*.test.ts",
    "tests/e2e/**/*.spec.ts"
  ],
  "project": ["src/ts/**/*.ts", "tests/**/*.ts", "docs/.vitepress/**/*.{ts,mts}"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["fallow", "@wordpress/env"]
}
